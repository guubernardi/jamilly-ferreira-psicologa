# Copie para .env (local) ou cadastre na Vercel > Settings > Environment Variables.

# URL canônica do site, SEM barra no final.
# Alimenta canonical, og:url, sitemap.xml, robots.txt, JSON-LD e llms.txt.
# Se não for definida, o fallback do nuxt.config.ts é usado.
NUXT_PUBLIC_SITE_URL=https://jamillyferreirapsicologa.com.br
